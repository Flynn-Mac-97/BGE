node_modules/
.agent-worktrees/
.tmp-agent-tests/

# Scratch directories dsh-agent leaves beside itself while a task runs.
tools/.dsh-agent.*

# Regenerated by the dev server on every write. Committing it would mean every
# file change also produced an index diff, and a stale checked-in copy is worse
# than no copy — the whole point of the index is that it is never behind.
*/.engine/

# A dev server log is a live file, not a record of anything.
agent-runs/dev-*.log

# measure.mjs regenerates these; nineteen thousand lines of run output is
# not evidence anyone reads.
agent-runs/see-marks/*seed*.json

# Captures a lane regenerates to prove one claim. The claim is in the report;
# the frame is a working file, and committing it means every run is a diff.
agent-runs/see/**/*.png
agent-runs/see/**/*.json
project/.engine/lane-browsers.json
