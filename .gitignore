node_modules/
.agent-worktrees/
.tmp-agent-tests/

# Scratch directories dsh-agent leaves beside itself while a task runs.
tools/.dsh-agent.*

# Regenerated by the dev server on every write. Committing it would mean every
# file change also produced an index diff, and a stale checked-in copy is worse
# than no copy — the whole point of the index is that it is never behind.
**/.engine/

project/.engine/lane-browsers.json

# The checkout's own coordination state: the work lock, the agent run
# registry, the server registry and the lane browsers. Live files about what is
# running here, never a record of anything.
/.engine/

# Agent output is working material, not engine content. Only the two ledgers
# and the README outlive a round; everything else is swept by `agent.sweep`.
# A finding worth keeping goes in a ledger, a guide, or a test — never a new
# markdown file left here.
agent-runs/*
!agent-runs/README.md
!agent-runs/painpoints.jsonl
!agent-runs/insights.jsonl

# Plugins and tests taken out of the engine and kept for reference. Engine
# discovery globs `plugins/builtin/*.js` and the test runner globs
# `test/*.test.mjs`, so nothing under here is loaded or run.
archive/

# Codemap's working state: what was asked, what was briefed, what it noticed.
# A record of one machine's session, not of the engine, and it changes under
# every question.
**/.codemap/

# The MCP servers this checkout is wired to. Every path in it is absolute and
# belongs to the machine it was written on, so a copy here is wrong for anyone
# else and goes stale the moment a tool moves.
**/.mcp.json

# Written by the project index from the plugin sources. A checked-in copy goes
# stale the moment a plugin registers a type, and the index is only useful when
# it is never behind.
plugins/builtin/registered-types.generated.json
