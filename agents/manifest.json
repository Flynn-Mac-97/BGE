    { "id": "arch-agent", "title": "Agent workspace", "kind": "document", "parent": "architecture", "file": "docs/agent-workspace.md" },
    { "id": "arch-design", "title": "Design and gaps", "kind": "document", "parent": "architecture", "file": "docs/design.md" },
