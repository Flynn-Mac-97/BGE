{
  "version": 2,
  "nodes": [
    { "id": "agent-framework", "title": "Agent Framework", "kind": "group" },
    { "id": "bootstrap", "title": "Start Here", "kind": "document", "parent": "agent-framework", "file": "agents/bootstrap.md" },
    { "id": "engine-base", "title": "Engine Base", "kind": "document", "parent": "agent-framework", "file": "ENGINE-BASE.md" },
    { "id": "architecture", "title": "Architecture", "kind": "document", "parent": "agent-framework", "file": "ARCHITECTURE.md" },
    { "id": "arch-kernel", "title": "Kernel and boot", "kind": "document", "parent": "architecture", "file": "docs/kernel.md" },
    { "id": "arch-entity", "title": "Entities and behaviours", "kind": "document", "parent": "architecture", "file": "docs/entity-model.md" },
    { "id": "arch-determinism", "title": "Determinism", "kind": "document", "parent": "architecture", "file": "docs/determinism.md" },
    { "id": "arch-surfaces", "title": "The ways in", "kind": "document", "parent": "architecture", "file": "docs/surfaces.md" },
    { "id": "arch-agent", "title": "Agent workspace", "kind": "document", "parent": "architecture", "file": "docs/agent-workspace.md" },
    { "id": "arch-design", "title": "Design and gaps", "kind": "document", "parent": "architecture", "file": "docs/design.md" },
    { "id": "core", "title": "Shared Rules", "kind": "instruction", "parent": "architecture", "file": "agents/core.md", "always": true },
    { "id": "code-style", "title": "Code Style", "kind": "instruction", "parent": "architecture", "file": "agents/code-style.md", "override": "code-style", "always": true },
    { "id": "comment-style", "title": "Comment Style", "kind": "instruction", "parent": "architecture", "file": "agents/comment-style.md", "override": "comment-style", "always": true },
    { "id": "engine", "title": "Engine", "kind": "instruction", "parent": "architecture", "file": "agents/engine.md", "match": ["engine/**"], "tests": ["node bin/engine.mjs check", "npm run test:offline", "npm test"] },
    { "id": "editor", "title": "Editor", "kind": "instruction", "parent": "architecture", "file": "agents/editor.md", "match": ["plugins/builtin/**", "engine/ui.js", "engine/shell.js", "engine/render.js"], "tests": ["node bin/engine.mjs check", "npm run test:offline", "npm test"] },
    { "id": "tooling", "title": "CLI and Tools", "kind": "instruction", "parent": "architecture", "file": "agents/tooling.md", "match": ["bin/**", "tools/**", "vite.config.js", "package.json", "agents/**", "project/agents/**"], "tests": ["node bin/engine.mjs check", "npm run test:offline", "npm test"] },
    { "id": "project", "title": "Project", "kind": "group", "parent": "agent-framework" },
    { "id": "game", "title": "Game", "kind": "instruction", "parent": "project", "file": "agents/game.md", "match": ["project/types/**", "project/behaviours/**", "project/levels/**", "project/assets/**", "project/plugins/**"], "tests": ["node bin/engine.mjs check --project <project>", "node bin/engine.mjs --headless --project <project> run tests.run"] },
    { "id": "game-tests", "title": "Game Tests", "kind": "instruction", "parent": "project", "file": "agents/game-tests.md", "match": ["project/tests/**"], "tests": ["node bin/engine.mjs check --project <project>", "node bin/engine.mjs --headless --project <project> run tests.run"] },
    { "id": "art", "title": "Art and Assets", "kind": "instruction", "parent": "project", "file": "agents/art.md", "match": ["project/assets/**", "project/types/**", "project/levels/**"], "triggers": ["mesh", "model", "texture", "sprite", "lowpoly", "art", "look", "character", "hud", "screen"] },
    { "id": "plugins", "title": "Plugins", "kind": "group", "parent": "agent-framework" },
    { "id": "skills", "title": "Skills", "kind": "group", "parent": "agent-framework" },
    { "id": "blender-3d", "title": "Blender 3D", "kind": "skill", "parent": "skills", "file": "agents/skills/blender-3d/SKILL.md", "optional": true, "triggers": ["blender", "3d model", ".blend", "mesh", "lowpoly", "character", "creature", "glb", "gltf", "model a", "sculpt"], "match": ["project/assets/**/*.blend", "project/assets/**/*.glb", "project/assets/**/*.gltf"] },
    { "id": "effects", "title": "Effects", "kind": "skill", "parent": "skills", "file": "agents/skills/effects/SKILL.md", "triggers": ["vfx", "effect", "effects", "particle", "particles", "beam", "bolt", "laser", "impact", "explosion", "muzzle flash", "spell", "trail", "aura", "smoke", "sparks", "shader", "decal"], "match": ["plugins/builtin/vfx.js", "plugins/builtin/vfx/**", "plugins/builtin/particles.js", "plugins/builtin/particle-painter.js", "plugins/builtin/combat-effects.js"] }
  ]
}
