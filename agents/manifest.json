    { "id": "engine", "title": "Engine", "kind": "instruction", "parent": "architecture", "file": "agents/engine.md", "match": ["engine/**"], "tests": ["node bin/engine.mjs check", "npm test"] },
    { "id": "editor", "title": "Editor", "kind": "instruction", "parent": "architecture", "file": "agents/editor.md", "match": ["plugins/builtin/**", "engine/ui.js", "engine/shell.js", "engine/render.js"], "tests": ["node bin/engine.mjs check", "npm test"] },
    { "id": "tooling", "title": "CLI and Tools", "kind": "instruction", "parent": "architecture", "file": "agents/tooling.md", "match": ["bin/**", "tools/**", "vite.config.js", "package.json", "agents/**", "project/agents/**"], "tests": ["node bin/engine.mjs check", "npm test"] },
    { "id": "project", "title": "Project", "kind": "group", "parent": "agent-framework" },
    { "id": "plugins", "title": "Plugins", "kind": "group", "parent": "agent-framework" },
    { "id": "skills", "title": "Skills", "kind": "group", "parent": "agent-framework" },
