+namespace {
+#ifdef KIMODO_HAVE_GGML
+// Raw observed features to the normalized space DDIM runs in, with the same
+// statistics decode uses: dims 0-4 are the global root, the rest the body.
+std::expected<std::vector<float>, std::string> normalized_observed(
+    const detail::ggml_motion_weights &weights, const detail::skeleton_spec &skeleton,
+    std::span<const float> observed) {
+    auto gm=weights.f32_values("stats.global_root.mean"), gs=weights.f32_values("stats.global_root.std");
+    auto bm=weights.f32_values("stats.body.mean"), bs=weights.f32_values("stats.body.std");
+    if (!gm || !gs || !bm || !bs) return std::unexpected("motion GGUF lacks normalization statistics");
+    const size_t motion_dim=skeleton.motion_dim(), body_dim=skeleton.body_dim();
+    std::vector<float> normalized(observed.begin(), observed.end());
+    for (size_t row=0; row<normalized.size()/motion_dim; ++row) {
+        auto *value=normalized.data()+row*motion_dim;
+        for (size_t d=0; d<5; ++d) value[d]=(value[d]-(*gm)[d])/std::sqrt((*gs)[d]*(*gs)[d]+1.e-5F);
+        for (size_t d=0; d<body_dim; ++d) value[5+d]=(value[5+d]-(*bm)[d])/std::sqrt((*bs)[d]*(*bs)[d]+1.e-5F);
+    }
+    return normalized;
+}
+#endif
+}
