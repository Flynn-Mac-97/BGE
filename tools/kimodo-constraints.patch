+std::expected<motion_data, std::string> model::generate_text_conditioned(
+    std::string_view utf8_prompt, const motion_condition &condition, unsigned frames, unsigned steps,
+    std::uint64_t seed, float text_cfg, float constraint_cfg) const {
+#ifdef KIMODO_HAVE_GGML
+    if (!impl_->text) return std::unexpected("model was loaded without a native text bundle");
+    const size_t values=static_cast<size_t>(frames)*impl_->skeleton->motion_dim();
+    if (condition.observed.size()!=values || condition.mask.size()!=values)
+        return std::unexpected("condition must hold frames * motion_dim values, observed and mask alike");
+    for (float value : condition.observed) if (!std::isfinite(value)) return std::unexpected("condition contains a non-finite value");
+    if (!std::isfinite(condition.first_heading)) return std::unexpected("first heading must be finite");
+    auto embedding = impl_->text->encode(utf8_prompt);
+    if (!embedding) return std::unexpected(embedding.error());
+    return generate_embedding_conditioned(*embedding, &condition, frames, steps, seed, text_cfg, constraint_cfg);
+#else
+    (void) utf8_prompt; (void) condition; (void) frames; (void) steps; (void) seed; (void) text_cfg; (void) constraint_cfg;
+    return std::unexpected("Kimodo was built without GGML support");
+#endif
+}
