#!/bin/sh
# dsh-agent POSIX shim (git-bash / WSL / macOS / Linux): execs the shared
# implementation next to it. Windows cmd/PowerShell use dsh-agent.cmd instead.
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -x "$basedir/node" ]; then
  exec "$basedir/node" "$basedir/dsh-agent.mjs" "$@"
else
  exec node "$basedir/dsh-agent.mjs" "$@"
fi
