    { "id": "project-tests", "title": "Game Tests", "kind": "instruction", "parent": "project", "file": "agents/tests.md", "match": ["project/tests/**"], "tests": ["node bin/engine.mjs check", "node bin/engine.mjs --headless run tests.run"] }
