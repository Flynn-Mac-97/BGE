{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/claude-code-session-rules.mjs"
            ],
            "timeout": 20,
            "statusMessage": "Reading the engine rules"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/claude-code-session-rules.mjs"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/tools/claude-code-style-reminder.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --max-time 1 -X POST -H \"Content-Type: application/json\" --data-binary @- http://localhost:4322/api/events || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s --max-time 1 -X POST -H \"Content-Type: application/json\" --data-binary @- http://localhost:4322/api/events || true"
          }
        ]
      }
    ]
  }
}
